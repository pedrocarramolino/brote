# --- Frontend (públicas: se incluyen en el bundle; NUNCA pongas claves secretas aquí) ---
# Endpoint del backend del asistente. Si se deja vacío, el asistente funciona en modo demostración.
VITE_ASSISTANT_ENDPOINT=/api/assistant

# --- Backend (solo servidor: configúralas en Vercel > Settings > Environment Variables) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
